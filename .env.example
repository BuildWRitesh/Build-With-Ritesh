# Public application origin, without a trailing slash
APP_URL=https://your-project.vercel.app

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# At least 32 random characters; signs secure admin sessions
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
# Generate with: npm run admin:hash (reads the password from stdin)
ADMIN_PASSWORD_HASH=scrypt$parameters$generated-by-the-command

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder

# Instagram Graph API credentials
INSTAGRAM_USER_ID=instagram-business-user-id
INSTAGRAM_ACCESS_TOKEN=instagram-long-lived-access-token
INSTAGRAM_GRAPH_VERSION=v23.0

# Resend email delivery
RESEND_API_KEY=re_placeholder
CONTACT_FROM_EMAIL=Portfolio <contact@your-verified-domain.com>
CONTACT_TO_EMAIL=buildwritesh@gmail.com
