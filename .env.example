# ── Application ──────────────────────────────────────────────────────────────
# Production origin of the site, without trailing slash
# Must match https://buildwithritesh.com in production
APP_URL=https://buildwithritesh.com

# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres connection string (server-only, NEVER expose to browser)
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ── Admin Authentication ───────────────────────────────────────────────────────
# At least 32 random characters — used to sign admin session cookies
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

# Admin login email
ADMIN_EMAIL=buildwritesh@gmail.com

# bcrypt/scrypt hash of the admin password — NEVER store plaintext password
# Generate with: npm run admin:hash   (reads password securely from stdin)
ADMIN_PASSWORD_HASH=scrypt$N$r$p$salt$hash

# ── Media Storage ─────────────────────────────────────────────────────────────
# Vercel Blob read/write token (server-only)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder

# ── Instagram ─────────────────────────────────────────────────────────────────
# Instagram Graph API credentials (server-only)
INSTAGRAM_USER_ID=instagram-business-user-id
INSTAGRAM_ACCESS_TOKEN=instagram-long-lived-access-token
INSTAGRAM_GRAPH_VERSION=v23.0

# ── Email (Contact form) ──────────────────────────────────────────────────────
# Resend API key (server-only)
RESEND_API_KEY=re_placeholder
CONTACT_FROM_EMAIL=Portfolio <contact@your-verified-domain.com>
CONTACT_TO_EMAIL=buildwritesh@gmail.com
